#!/bin/sh
# 1) marked-term check (reads the pushed refs from stdin), 2) fast lint and type check.
# The full suite is `python scripts/check.py`; it is too slow for every push.
PY=".venv/Scripts/python.exe"; [ -x "$PY" ] || PY=python
"$PY" -X utf8 "$(git rev-parse --git-dir)/hooks/sensitive_check.py" pre-push "$@" || exit 1
cd "$(git rev-parse --show-toplevel)" || exit 1
exec "$PY" -X utf8 scripts/check.py --fast
